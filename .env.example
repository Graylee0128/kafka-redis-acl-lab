# Lab 專用帳密。cp .env.example .env 後使用；.env 已被 .gitignore 排除。
# 密碼限制：12 碼以上英數字（會嵌進 JAAS / SCRAM 字串，特殊字元會破壞語法）

# KRaft cluster id（22 字元 base64 UUID，不是秘密）
KAFKA_CLUSTER_ID=MkU3OEVBNTcwNTJENDM2Qk

KAFKA_ADMIN_PASSWORD=LabKafkaAdmin2026
KAFKA_PRODUCER_PASSWORD=LabProducer2026
KAFKA_CONSUMER_PASSWORD=LabConsumer2026

REDIS_ADMIN_PASSWORD=LabRedisAdmin2026
REDIS_APP_PASSWORD=LabRedisApp2026

# host 上 6379 已被占用時改這個（只影響從 host 連線，容器之間仍用 redis:6379）
# REDIS_HOST_PORT=16379
# host 上 8080 已被占用時改這個（權限申請面板）
# WEB_HOST_PORT=18080
